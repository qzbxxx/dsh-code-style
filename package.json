{
  "name": "dsh-code-style",
  "version": "0.1.0",
  "description": "把 code-style 技能打包成 DSH 插件：按“可读性优先”的规则编写、重构和审查代码。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qzbxxx/dsh-code-style.git"
  },
  "homepage": "https://github.com/qzbxxx/dsh-code-style#readme",
  "bugs": {
    "url": "https://github.com/qzbxxx/dsh-code-style/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "assets/SKILL.md",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "skill",
    "code-style"
  ],
  "scripts": {
    "test": "node test/plugin.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
